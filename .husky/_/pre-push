#!/usr/bin/env sh

# Where git actually looks. `core.hooksPath` is `.husky/_`, and it is relative,
# so it resolves inside whichever worktree is being pushed from rather than in
# the main checkout. On main that directory is husky's own, generated by
# `npm install` and git-ignored.
#
# This branch carries no husky and no install to generate it, so nothing lived
# at that path and git ran no hook here at all — the gate beside this file had
# never fired. Committing the shim is what connects them, and keeps the gate
# itself readable in `.husky/pre-push` where a reader expects it.
sh "$(dirname "$0")/../pre-push" "$@"
